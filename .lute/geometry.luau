--[[
	Writes `workspace/orion-app/src/geometry.ts` from the CLI's geometry constants, so the app draws cards and groups at the sizes and
	spacing the CLI places them with. Run it after changing `workspace/orion-cli/src/geometry.luau`, and commit what it writes. With
	`--check`, it leaves the file as it was and exits nonzero when it's out of date.
]]
local fs = require("@std/fs")
local path = require("@std/path")
local process = require("@std/process")

local geometry = require("@cli/geometry")

local runScript = require("@cli/runScript")

local HEADER =
	"// Generated by .lute/geometry.luau from workspace/orion-cli/src/geometry.luau, which explains each value. Run `lute run geometry` to update."
local INDENT = "  "

local target = path.resolve("workspace/orion-app/src/geometry.ts")
local checkOnly = table.find(process.args, "--check") ~= nil

local function sortedKeys(value: { [string]: unknown }): { string }
	local keys = {}

	for key in value do
		assert(type(key) == "string", "geometry keys must be strings")
		table.insert(keys, key)
	end

	table.sort(keys)
	return keys
end

-- Objects always break across lines, which Prettier keeps as written.
local function render(value: unknown, depth: number): string
	if type(value) == "number" then
		return tostring(value)
	end

	assert(type(value) == "table", `geometry values must be numbers or tables, not {type(value)}`)

	local inner = string.rep(INDENT, depth + 1)
	local lines = { "{" }

	for _, key in sortedKeys(value :: any) do
		table.insert(lines, `{inner}{key}: {render((value :: any)[key], depth + 1)},`)
	end

	table.insert(lines, `{string.rep(INDENT, depth)}}`)
	return table.concat(lines, "\n")
end

local function generate(): string
	local parts = { HEADER, "" }

	for _, name in sortedKeys(geometry :: any) do
		table.insert(parts, `export const {name} = {render((geometry :: any)[name], 0)}`)
	end

	return table.concat(parts, "\n") .. "\n"
end

runScript(function()
	local contents = generate()
	local current = if fs.exists(target) then fs.readFileToString(target) else nil

	if current == contents then
		print("workspace/orion-app/src/geometry.ts is up to date")
		return
	end

	if checkOnly then
		print("workspace/orion-app/src/geometry.ts is out of date. Run `lute run geometry` and commit the result.")
		process.exit(1)
	end

	fs.writeStringToFile(target, contents)
	print("Updated workspace/orion-app/src/geometry.ts")
end)
