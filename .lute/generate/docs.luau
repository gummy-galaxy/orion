--[[
	Writes the generated reference pages in `docs/reference/` from the CLI's
	command table, the MCP tool catalog, the syntax tables its parsers read, and
	the telemetry event catalog, so the docs site always shows the surface the
	code defines. Run it after changing a command, an option, an MCP tool, a
	telemetry event, or the syntax of `--where`, selectors, or refs, and commit
	what it writes. It formats the pages with the docs site's Prettier, so run
	`npm ci` in `docs/` first.
]]
local fs = require("@std/fs")
local json = require("@std/json")
local path = require("@std/path")
local process = require("@std/process")

local buildTools = require("@cli/cli/mcp/catalog/buildTools")
local cliModule = require("@cli/cli")
local describeCommands = require("@cli/cli/describeCommands")
local getArgumentLabel = require("@cli/cli/arguments/getArgumentLabel")
local mcpTypes = require("@cli/cli/mcp/types")
local querySyntax = require("@cli/canvas/query/querySyntax")
local refForms = require("@cli/sources/refForms")
local selectors = require("@cli/canvas/query/selectors")
local telemetryEvents = require("@cli/telemetry/events")

type CommandDescription = describeCommands.CommandDescription
type Argument = describeCommands.Argument
type Field = mcpTypes.Field
type Tool = mcpTypes.Tool
type TelemetryEvent = telemetryEvents.Event

type Page = {
	file: path.Path,
	contents: string,
}

local HEADER =
	"<!-- Generated by .lute/generate/docs.luau from the command table. Run `lute run generate docs` to update. -->"
local SYNTAX_HEADER = "<!-- Generated by .lute/generate/docs.luau from the tables the CLI's parsers read. "
	.. "Run `lute run generate docs` to update. -->"
local TELEMETRY_HEADER = "<!-- Generated by .lute/generate/docs.luau from the telemetry event catalog. "
	.. "Run `lute run generate docs` to update. -->"

local referenceDir = path.resolve("docs/reference")

-- Help text is plain prose, but VitePress compiles Markdown as Vue templates,
-- so angle brackets and table pipes must be escaped outside code.
local function escape(text: string?): string
	local escaped = (text or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub("|", "\\|")
	return escaped
end

local function renderArguments(arguments: { Argument }): string
	if #arguments == 0 then
		return ""
	end

	local lines = { "| Argument | Description |", "| --- | --- |" }

	for _, argument in arguments do
		local required = if argument.required then "**Required.** " else ""
		table.insert(lines, `| \`{getArgumentLabel(argument)}\` | {required}{escape(argument.help)} |`)
	end

	return table.concat(lines, "\n") .. "\n"
end

local function renderCommand(command: CommandDescription, depth: number): string
	local heading = string.rep("#", depth)
	local parts = {
		`{heading} {command.name}`,
		"",
		escape(command.help),
		"",
		"```sh",
		command.usage,
		"```",
		"",
		renderArguments(command.arguments),
	}

	for _, child in command.commands do
		table.insert(parts, renderCommand(child, math.min(depth + 1, 4)))
	end

	return table.concat(parts, "\n")
end

local function slug(command: CommandDescription): string
	local name = command.name:gsub("^orion ", "")
	return name
end

local function renderIndex(root: CommandDescription): string
	local lines = {
		HEADER,
		"",
		"# CLI reference",
		"",
		escape(root.help) .. ".",
		"",
		"```sh",
		root.usage,
		"```",
		"",
		"Every command also takes `--canvas <name>` to work on a specific canvas, and `--help` (`-h`) to print its help.",
		"",
		"| Command | What it does |",
		"| --- | --- |",
	}

	for _, command in root.commands do
		table.insert(lines, `| [\`{command.name}\`](./{slug(command)}) | {escape(command.help)} |`)
	end

	return table.concat(lines, "\n") .. "\n"
end

-- The Reference section's own page, so the nav's Reference link lands on
-- content rather than a menu.
local function renderHome(): string
	local lines = {
		HEADER,
		"",
		"# Reference",
		"",
		"These pages are generated from the code that defines each surface, so they always match what Orion accepts.",
		"",
		"- [CLI](./cli/): every command of `orion`, with the options it takes.",
		"- [MCP](./mcp): the tools `orion mcp start` serves to agents, each running a CLI command.",
		"- [Telemetry](./telemetry): the events Orion sends once someone opts in to sharing usage data.",
		"",
		"The syntax commands take inside their arguments:",
		"",
		"- [Queries](./query): the fields `--where` matches on, and how comparisons combine.",
		"- [Selectors](./selectors): the ways to name a card or group in place of its id.",
		"- [Refs](./refs): the forms `--ref` takes for pull requests, issues, and branches.",
	}

	return table.concat(lines, "\n") .. "\n"
end

-- How each value type reads in a tool's argument table, as the JSON its schema
-- takes.
local TYPE_LABELS: { [string]: string } = {
	text = "string",
	words = "string",
	list = "string list",
	commaList = "string list",
	jsonList = "object list",
	command = "string list",
}

local function getTypeLabel(field: Field): string
	if field.values == nil then
		return TYPE_LABELS[field.type] or field.type
	end

	local values: { string } = {}

	for _, value in field.values do
		table.insert(values, if value == "" then '""' else value)
	end

	return table.concat(values, " \\| ")
end

local function renderTool(tool: Tool): string
	local parts = {
		`## {tool.name}`,
		"",
		escape(tool.description),
		"",
	}

	table.insert(parts, `Runs \`orion {table.concat(tool.command, " ")}\`.\n`)

	if #tool.fields == 0 then
		table.insert(parts, "Takes no arguments.\n")
	else
		table.insert(parts, "| Argument | Type | Description |")
		table.insert(parts, "| --- | --- | --- |")

		for _, field in tool.fields do
			local kind = getTypeLabel(field)
			local required = if field.required then "**Required.** " else ""
			table.insert(parts, `| \`{field.name}\` | {kind} | {required}{escape(field.description)} |`)
		end

		table.insert(parts, "")
	end

	return table.concat(parts, "\n")
end

local function renderMcp(tools: { Tool }): string
	local parts = {
		HEADER,
		"",
		"# MCP reference",
		"",
		"`orion mcp start` serves these tools over stdio. Each one runs a CLI command, so it reads and "
			.. "writes the same data.",
		"",
	}

	for _, tool in tools do
		table.insert(parts, renderTool(tool))
	end

	return table.concat(parts, "\n")
end

-- Wraps text in inline code for a table cell. Code needs no HTML escaping, but
-- a pipe would still end the cell, and text holding a backtick needs a longer
-- fence.
local function code(text: string): string
	local cell = text:gsub("|", "\\|")
	return if cell:find("`", 1, true) then `\`\` {cell} \`\`` else `\`{cell}\``
end

local function renderQuery(): string
	local parts = {
		SYNTAX_HEADER,
		"",
		"# Query reference",
		"",
		"`orion node query --where`, and every command that takes `--where`, select cards and groups with an "
			.. "expression. An expression compares fields to quoted values, and combines comparisons with `and`, "
			.. "`or`, and `not`. Quote the whole expression for the shell, with single quotes around "
			.. "double-quoted values:",
		"",
		"```sh",
		`orion node query --where '{querySyntax.examples[1]}'`,
		"```",
		"",
		"## Fields",
		"",
		"Values are always quoted, numbers and booleans included. "
			.. "A node without the field never matches, even under `not` or `!=`.",
		"",
		"| Field | Matches | Example |",
		"| --- | --- | --- |",
	}

	for _, field in querySyntax.fields do
		local notes = { escape(field.help) }

		if field.isText then
			table.insert(notes, "Takes `~`.")
		end

		if field.values then
			local values: { string } = {}

			for _, value in field.values do
				table.insert(values, `\`"{value}"\``)
			end

			table.insert(notes, `Takes {table.concat(values, " or ")}.`)
		end

		table.insert(parts, `| {code(field.name)} | {table.concat(notes, " ")} | {code(field.example)} |`)
	end

	table.insert(parts, "")
	table.insert(parts, "## Operators")
	table.insert(parts, "")
	table.insert(parts, "| Operator | Matches |")
	table.insert(parts, "| --- | --- |")

	for _, operator in querySyntax.operators do
		table.insert(parts, `| {code(operator.symbol)} | {escape(operator.help)} |`)
	end

	table.insert(parts, "")
	table.insert(parts, "## Combining")
	table.insert(parts, "")
	table.insert(parts, "Listed tightest first, so `a or b and c` reads as `a or (b and c)`. Keywords ignore case.")
	table.insert(parts, "")
	table.insert(parts, "| Syntax | Matches |")
	table.insert(parts, "| --- | --- |")

	for _, combinator in querySyntax.combinators do
		table.insert(parts, `| {code(combinator.symbol)} | {escape(combinator.help)} |`)
	end

	table.insert(parts, "")
	table.insert(parts, "## Values")
	table.insert(parts, "")
	table.insert(
		parts,
		"Quote a value with `\"` or `'`. Inside it, a backslash escapes the quote that opened it or another "
			.. "backslash, and nothing else."
	)
	table.insert(parts, "")
	table.insert(parts, "## Examples")
	table.insert(parts, "")
	table.insert(parts, "```sh")

	for _, example in querySyntax.examples do
		table.insert(parts, `orion node query --where '{example}'`)
	end

	table.insert(parts, "```")
	table.insert(parts, "")
	table.insert(parts, "## Sorting and paging")
	table.insert(parts, "")
	table.insert(
		parts,
		"`orion node query` also takes `--sort`: fields from the table above, separated by commas. "
			.. "A leading `-` sorts that field descending. Numbers sort by size and other values ignore case. "
			.. "Nodes without the field come last either way, and ties fall to the next field, then to canvas order. "
			.. "After sorting, `--offset` skips matches and `--limit` caps how many print."
	)
	table.insert(parts, "")
	table.insert(parts, "```sh")

	for _, example in querySyntax.sortExamples do
		table.insert(parts, `orion node query --where '{querySyntax.examples[1]}' --sort '{example}' --limit 20`)
	end

	table.insert(parts, "```")

	return table.concat(parts, "\n") .. "\n"
end

local function renderSelectors(): string
	local parts = {
		SYNTAX_HEADER,
		"",
		"# Selector reference",
		"",
		"Wherever a command takes the id of a card or group, it also takes a selector. "
			.. "A selector must match exactly one node; when it matches several, the command lists them with "
			.. "their ids so you can pick one.",
		"",
		"```sh",
		`orion node show '{selectors.list[1].examples[1]}'`,
		"```",
		"",
		"| Selector | Selects | Examples |",
		"| --- | --- | --- |",
	}

	for _, selector in selectors.list do
		local examples: { string } = {}

		for _, example in selector.examples do
			table.insert(examples, code(example))
		end

		table.insert(parts, `| {code(selector.form)} | {escape(selector.help)} | {table.concat(examples, "<br>")} |`)
	end

	table.insert(parts, "")
	table.insert(
		parts,
		'Selectors match the way [`--where`](./query) does, so `ref:` takes the same keys as `ref = "…"`, and its '
			.. "URLs and `source:key` refs follow the [ref forms](./refs)."
	)

	return table.concat(parts, "\n") .. "\n"
end

local function renderRefs(): string
	local parts = {
		SYNTAX_HEADER,
		"",
		"# Ref reference",
		"",
		"A ref ties a card to something outside Orion: a pull request, an issue, or a branch. "
			.. "`--ref` takes one in any of these forms, and Orion stores it as a key. "
			.. "Queries and selectors match refs by that key.",
		"",
		"```sh",
		`orion card set <id> --ref {refForms[1].example}`,
		"```",
		"",
		"Forms are tried in this order.",
		"",
		"| Form | Refers to | Example | Key |",
		"| --- | --- | --- | --- |",
	}

	for _, form in refForms do
		local help = escape(form.help)

		if form.needs then
			help ..= ` {escape(form.needs)}`
		end

		table.insert(parts, `| {code(form.form)} | {help} | {code(form.example)} | {code(form.key)} |`)
	end

	table.insert(parts, "")
	table.insert(
		parts,
		"With no sources configured, only github.com pull requests, issues, and branches resolve. "
			.. "[Sources](/guide/sources) explains adding GitHub and Jira sources."
	)

	return table.concat(parts, "\n") .. "\n"
end

-- Who sends an event, as the page names them.
local SOURCE_LABELS: { [string]: string } = {
	app = "the app",
	cli = "the CLI",
	mcp = "the MCP server",
}

local function renderTelemetryEvent(event: TelemetryEvent): string
	local senders: { string } = {}

	for _, source in event.sources do
		table.insert(senders, SOURCE_LABELS[source])
	end

	local parts = {
		`### {event.name}`,
		"",
		`{escape(event.help)} Sent by {table.concat(senders, " and ")}.`,
		"",
		"| Property | Type | Description |",
		"| --- | --- | --- |",
	}

	for _, property in event.properties do
		local description = escape(property.help)

		if property.values then
			local values: { string } = {}

			for _, value in property.values do
				table.insert(values, code(value))
			end

			description ..= ` One of {table.concat(values, ", ")}.`
		end

		table.insert(parts, `| {code(property.name)} | {property.type} | {description} |`)
	end

	table.insert(parts, "")

	return table.concat(parts, "\n")
end

local function renderTelemetry(): string
	local parts = {
		TELEMETRY_HEADER,
		"",
		"# Telemetry reference",
		"",
		"These are the events Orion sends once someone opts in to sharing anonymous usage data, and nothing else. "
			.. "Without that choice, it sends nothing.",
		"",
		"Events hold counts, durations, and the names of Orion's own commands and features. "
			.. "They never hold titles, notes, refs, repository names, URLs, file paths, or option values. "
			.. "Every event also carries the version, commit, and channel of the build that sent it, and events "
			.. "from the app carry a session id that runs from launch to quit.",
		"",
		"The same list is published as [JSON](/reference/telemetry.json), which the telemetry service checks every "
			.. "event against. It drops any event or property that isn't listed.",
		"",
		"Nothing goes straight from the app, a command, or an agent to the network. "
			.. "Events wait in a small queue in Orion's data folder, and `orion server start`, which the app runs, "
			.. "sends them periodically. A batch that can't be sent is dropped, never retried. "
			.. "Setting `DO_NOT_TRACK=1` or `ORION_TELEMETRY=0` keeps everything off whatever was chosen, "
			.. "and a machine that isn't sharing keeps nothing to send later.",
		"",
	}

	for _, family in telemetryEvents.families do
		table.insert(parts, `## {family.name}`)
		table.insert(parts, "")
		table.insert(parts, escape(family.help))
		table.insert(parts, "")

		for _, event in telemetryEvents.list do
			if event.family == family.name then
				table.insert(parts, renderTelemetryEvent(event))
			end
		end
	end

	return table.concat(parts, "\n")
end

-- The site's config reads this to build the reference sidebar, so a new command
-- shows up without editing it.
local function renderSidebar(root: CommandDescription): string
	local items: json.Array = {}

	for _, command in root.commands do
		table.insert(items, json.object({ text = slug(command), link = `/reference/cli/{slug(command)}` }))
	end

	return json.serialize(items, true) .. "\n"
end

local function collectPages(): { Page }
	local root = cliModule.describe()
	local tools = buildTools(root)
	local pages: { Page } = {
		{ file = path.join(referenceDir, "index.md"), contents = renderHome() },
		{ file = path.join(referenceDir, "cli", "index.md"), contents = renderIndex(root) },
		{ file = path.join(referenceDir, "cli", "sidebar.json"), contents = renderSidebar(root) },
		{ file = path.join(referenceDir, "mcp.md"), contents = renderMcp(tools) },
		{ file = path.join(referenceDir, "query.md"), contents = renderQuery() },
		{ file = path.join(referenceDir, "refs.md"), contents = renderRefs() },
		{ file = path.join(referenceDir, "selectors.md"), contents = renderSelectors() },
		{ file = path.join(referenceDir, "telemetry.md"), contents = renderTelemetry() },
	}

	for _, command in root.commands do
		local contents = `{HEADER}\n\n{renderCommand(command, 1)}`
		table.insert(pages, { file = path.join(referenceDir, "cli", `{slug(command)}.md`), contents = contents })
	end

	return pages
end

-- Reads every file the generator owns, so pages for removed commands count as
-- stale too.
local function readCurrentPages(): { [string]: string }
	local current: { [string]: string } = {}
	local commandsDir = path.join(referenceDir, "cli")

	for _, directory in { referenceDir, commandsDir } do
		if not fs.exists(directory) then
			continue
		end

		for _, entry in fs.listDirectory(directory) do
			local file = path.join(directory, entry.name)

			if entry.type == "file" and (entry.name:match("%.md$") or entry.name == "sidebar.json") then
				current[path.format(file)] = fs.readFileToString(file)
			end
		end
	end

	return current
end

local function writePages(pages: { Page }, current: { [string]: string })
	for file in current do
		fs.remove(file)
	end

	for _, page in pages do
		fs.writeStringToFile(page.file, page.contents)
	end
end

-- Formats the pages with the docs site's Prettier, so they pass its format
-- check as written.
local function formatPages(pages: { Page })
	local prettier = path.resolve("docs/node_modules/.bin/prettier")
	assert(fs.exists(prettier), "Prettier is missing; run npm ci in docs/")

	local files = { path.format(prettier), "--write", "--log-level", "warn" }

	for _, page in pages do
		table.insert(files, path.format(page.file))
	end

	local result = process.run(files, { cwd = "docs" })
	assert(result.ok, `Prettier failed: {result.stderr}`)
end

-- Writes the pages, or with `checkOnly` puts them back as they were. Returns
-- false when `checkOnly` finds one out of date.
local function generateDocs(checkOnly: boolean): boolean
	local current = readCurrentPages()
	local pages = collectPages()
	writePages(pages, current)
	formatPages(pages)

	local generated = readCurrentPages()
	local stale: { string } = {}

	for file, contents in generated do
		if current[file] ~= contents then
			table.insert(stale, file)
		end
	end

	for file in current do
		if generated[file] == nil then
			table.insert(stale, file)
		end
	end

	table.sort(stale)

	if checkOnly then
		writePages({}, generated)

		for file, contents in current do
			fs.writeStringToFile(file, contents)
		end
	end

	if checkOnly and #stale > 0 then
		print("These reference pages are out of date. Run `lute run generate docs` and commit the result:")

		for _, file in stale do
			print(`  {path.format(path.relative(process.cwd(), file))}`)
		end

		return false
	end

	print(
		if #stale == 0
			then "Reference pages are up to date"
			else `Updated {#stale} reference {if #stale == 1 then "page" else "pages"}`
	)

	return true
end

return generateDocs
