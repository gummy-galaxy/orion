{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "0.1.0",
  "identifier": "com.vocksel.orion",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../app",
      "script": "npm run dev -- --host localhost --port 5199 --strictPort"
    },
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": {
      "cwd": "../../app",
      "script": "npm run build"
    },
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orion",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
