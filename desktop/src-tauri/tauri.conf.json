{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
  "version": "0.1.0",
  "identifier": "com.vocksel.orion",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../app",
      "script": "npm run dev -- --host localhost --port 5199 --strictPort"
    },
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": {
      "cwd": "../",
      "script": "npm --prefix ../app run build && cd ../cli && lute run prepare-sidecar && lute run acknowledgements"
    },
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Marin Minnerly",
    "externalBin": ["binaries/orion"],
    "resources": {
      "../../app/dist/": "dist/",
      "Credits.rtf": "Credits.rtf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
