{
  "name": "orion-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --root src",
    "coverage": "vitest run --root src --coverage.enabled --coverage.include=\"**/*.{ts,tsx}\" --coverage.exclude=\"**/*.{test,stories}.{ts,tsx}\" --coverage.exclude=\"perf/**\" --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html --coverage.reportsDirectory=../coverage",
    "lint": "oxlint",
    "storybook": "ORION_STORYBOOK=1 STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "ORION_STORYBOOK=1 STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "preview": "vite preview",
    "format": "prettier --write src scripts",
    "perf": "node scripts/perf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "jotai": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "libavoid-js": "^0.5.0-beta.5",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
