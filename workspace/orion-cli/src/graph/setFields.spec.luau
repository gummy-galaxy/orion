local test = require("@std/test")

local addItem = require("@root/graph/addItem")
local findRef = require("@root/refs/findRef")
local getItem = require("@root/graph/getItem")
local setFields = require("@root/graph/setFields")
local setRef = require("@root/refs/setRef")
local testing = require("@root/testing")

local task = testing.task

test.case("add and set take a gate kind, and a gate stays one when its repository changes", function(assert)
	local doc = testing.createDoc({})
	local item = addItem(doc, "Closure audit", { kind = "gate" })
	assert.eq(testing.primaryType(item), "gate")
	setFields(doc, item.id, { repo = "vocksel/orion" })
	assert.eq(testing.primaryType(item), "gate")
	setFields(doc, item.id, { kind = "step" })
	assert.eq(testing.primaryType(item), "placeholder")
	assert.throwsWith("kind must be one of step, gate, component", function()
		setFields(doc, item.id, { kind = "milestone" })
	end)
end)

test.case("a component keeps its kind when its repository changes, and step turns it back into work", function(assert)
	local doc = testing.createDoc({})
	local item = addItem(doc, "Desktop shell", { kind = "component", repo = "vocksel/orion" })
	assert.eq(testing.primaryType(item), "component")
	setFields(doc, item.id, { repo = "" })
	assert.eq(testing.primaryType(item), "component")
	setFields(doc, item.id, { kind = "step" })
	assert.eq(testing.primaryType(item), "step")
end)

test.case("setFields keeps an item's id when its label changes", function(assert)
	local doc = testing.createDoc({ testing.group("g", "Group") })
	local item = addItem(doc, "Ship it", {})
	setFields(doc, item.id, { label = "Ship the release" })
	setFields(doc, "g", { label = "Release work" })
	local id = item.id
	assert.eq(getItem(doc, id).data.label, "Ship the release")
	assert.eq(item.id, id)
	assert.eq(getItem(doc, "g").data.label, "Release work")
end)

test.case("repo takes a full repository name and clearing it leaves refs alone", function(assert)
	local doc = testing.createDoc({})
	assert.throwsWith("repo must be owner/name", function()
		addItem(doc, "Short", { repo = "orion" })
	end)
	local item = addItem(doc, "Component", { repo = "vocksel/orion", kind = "component" })
	assert.eq(item.data.repo, "vocksel/orion")
	setRef(item, { source = "github", kind = "issue", key = "vocksel/orion#12" })
	setFields(doc, item.id, { repo = "" })
	assert.eq(item.data.repo, nil)
	assert.eq(testing.primaryType(item), "component")
	assert.neq(findRef(item, "issue", "vocksel/orion#12"), nil)
end)

test.case("setFields arranges groups and asks the app to lay them out again", function(assert)
	local doc = testing.createDoc({ testing.group("g", "Group"), task("x", "X", "todo", "g") })
	local group = setFields(doc, "g", { arrange = "custom" })
	assert.eq(group.data.arrange, "custom")
	assert.eq(group.data.layout, nil)
	setFields(doc, "g", { arrange = "auto" })
	assert.eq(group.data.arrange, nil)
	assert.eq(group.data.layout, "refit")
end)

test.case("setFields rejects bad arrangements", function(assert)
	local doc = testing.createDoc({ testing.group("g", "Group"), task("x", "X", "todo", "g") })
	assert.throwsWith("arrange must be one of auto, custom", function()
		setFields(doc, "g", { arrange = "grid" })
	end)
	assert.throwsWith("only groups take an arrangement", function()
		setFields(doc, "x", { arrange = "custom" })
	end)
	assert.eq(doc.nodes[1].data.arrange, nil)
end)

test.case("a group takes a cover and background, and an empty value clears them", function(assert)
	local doc = testing.createDoc({ testing.group("ws", "Workspace", nil), task("a", "A", "todo") })
	setFields(doc, "ws", { cover = "image-logo.png", background = "card.background" })
	local group = getItem(doc, "ws")
	assert.eq(group.data.cover, "image-logo.png")
	assert.eq(group.data.background, "card.background")
	setFields(doc, "ws", { background = "" })
	assert.eq(group.data.background, nil)
	assert.eq(group.data.cover, "image-logo.png")
	setFields(doc, "ws", { cover = "" })
	assert.eq(group.data.cover, nil)
end)

test.case("a group takes a header, and an empty value clears it", function(assert)
	local doc = testing.createDoc({ testing.group("ws", "Workspace", nil) })
	setFields(doc, "ws", { header = "# Sprint 14" })
	assert.eq(getItem(doc, "ws").data.header, "# Sprint 14")
	setFields(doc, "ws", { header = "" })
	assert.eq(getItem(doc, "ws").data.header, nil)
end)

test.case("adding a header moves the group's top edge up and keeps its cards where they are", function(assert)
	local group = testing.group("ws", "Workspace", nil)
	group.position = { x = 100, y = 300 }
	group.height = 300
	local doc = testing.createDoc({ group, task("a", "A", "todo", "ws") })
	doc.nodes[2].position = { x = 32, y = 78 }
	setFields(doc, "ws", { header = "# Sprint 14" })
	assert.eq(getItem(doc, "ws").position.y, 300 - 112)
	assert.eq(getItem(doc, "ws").height, 300 + 112)
	assert.eq(getItem(doc, "a").position.y, 78 + 112)
	setFields(doc, "ws", { header = "" })
	assert.eq(getItem(doc, "ws").position.y, 300)
	assert.eq(getItem(doc, "ws").height, 300)
	assert.eq(getItem(doc, "a").position.y, 78)
end)

test.case("an item refuses a cover or background or header, and a group refuses a bad one", function(assert)
	local doc = testing.createDoc({ testing.group("ws", "Workspace", nil), task("a", "A", "todo") })
	assert.throwsWith('"a" is an item; only groups take a cover, background, or header', function()
		setFields(doc, "a", { cover = "image-logo.png" })
	end)
	assert.throwsWith('"a" is an item; only groups take a cover, background, or header', function()
		setFields(doc, "a", { background = "#fff" })
	end)
	assert.throwsWith('"a" is an item; only groups take a cover, background, or header', function()
		setFields(doc, "a", { header = "# Hi" })
	end)
	assert.throws(function()
		setFields(doc, "ws", { cover = "../orion.json" })
	end)
	assert.throws(function()
		setFields(doc, "ws", { background = "red" })
	end)
	assert.eq(getItem(doc, "ws").data.cover, nil)
end)

test.case("setFields snoozes and wakes a work item, and refuses a time that isn't UTC", function(assert)
	local doc = testing.createDoc({ testing.group("g", "G"), task("a", "A", "todo") })
	setFields(doc, "a", { snoozedUntil = "2026-10-12T17:00:00Z" })
	assert.eq(getItem(doc, "a").data.snoozedUntil, "2026-10-12T17:00:00Z")
	setFields(doc, "a", { snoozedUntil = "" })
	assert.eq(getItem(doc, "a").data.snoozedUntil, nil)
	assert.throws(function()
		setFields(doc, "a", { snoozedUntil = "next week" })
	end)
	assert.throws(function()
		setFields(doc, "g", { snoozedUntil = "2026-10-12T17:00:00Z" })
	end)
end)

test.case("setFields drops a card's measured size when its text or shape changes", function(assert)
	local note = testing.task("n", "Short", "todo", nil, { type = "note" })
	note.width = 216
	note.height = 96
	local doc = testing.createDoc({ note })

	setFields(doc, "n", { status = "done" })
	assert.eq(note.height, 96)

	setFields(doc, "n", { label = "Longer" })
	assert.eq(note.width, nil)
	assert.eq(note.height, nil)
end)

test.case("a kind turns a note into a work item", function(assert)
	local doc = testing.createDoc({ testing.task("n", "Idea", "todo", nil, { type = "note" }) })
	doc.nodes[1].width = 240
	doc.nodes[1].height = 120
	setFields(doc, "n", { kind = "step", status = "todo" })
	assert.eq(testing.primaryType(doc.nodes[1]), "step")
	assert.eq(doc.nodes[1].width, nil)
end)
