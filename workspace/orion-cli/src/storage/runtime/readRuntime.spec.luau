local fs = require("@std/fs")
local path = require("@std/path")
local test = require("@std/test")

local fileNames = require("@root/fileNames")
local readRuntime = require("@root/storage/runtime/readRuntime")
local testing = require("@root/testing")

test.case("readRuntime ignores absent and malformed records", function(assert)
	local root = testing.directory("runtime-read")
	assert.eq(readRuntime(root), nil)
	fs.createDirectory(root)
	local file = path.join(root, fileNames.runtime)
	fs.writeStringToFile(file, "not json")
	assert.eq(readRuntime(root), nil)
	fs.writeStringToFile(file, [[{"pid":"123","url":"http://127.0.0.1:5198"}]])
	assert.eq(readRuntime(root), nil)
end)
