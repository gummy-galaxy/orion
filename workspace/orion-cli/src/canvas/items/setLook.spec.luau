local test = require("@std/test")

local setLook = require("@root/canvas/items/setLook")
local testing = require("@root/testing")

test.case("setLook sets and clears a component's shape and color", function(assert)
	local component = testing.task("api", "API", "todo", nil, { type = "component" })
	setLook(component, { shape = "store", color = "teal" })
	assert.eq(component.data.shape, "store")
	assert.eq(component.data.color, "teal")
	setLook(component, { shape = "", color = "" })
	assert.eq(component.data.shape, nil)
	assert.eq(component.data.color, nil)
end)

test.case("setLook refuses a shape or color on work", function(assert)
	local step = testing.task("a", "A", "todo")
	setLook(step, {})
	assert.throwsWith("only components take a shape", function()
		setLook(step, { shape = "store" })
	end)
	assert.throwsWith("only components and groups take a color", function()
		setLook(step, { color = "teal" })
	end)
end)
