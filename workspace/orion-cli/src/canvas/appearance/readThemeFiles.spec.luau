local fs = require("@std/fs")
local path = require("@std/path")
local test = require("@std/test")

local readThemeFiles = require("@root/canvas/appearance/readThemeFiles")
local testing = require("@root/testing")

test.case("reads nothing when the themes folder is missing", function(assert)
	local root = testing.directory("theme-files-missing")
	fs.createDirectory(root, { makeParents = true })

	assert.eq(#readThemeFiles(root), 0)
end)

test.case("lists only json files in the themes folder, sorted by name", function(assert)
	local root = testing.directory("theme-files-list")
	local folder = path.join(root, "themes")
	fs.createDirectory(path.join(folder, "nested.json"), { makeParents = true })
	fs.writeStringToFile(path.join(folder, "zebra.json"), '{"name":"Zebra"}')
	fs.writeStringToFile(path.join(folder, "alpha.json"), '{"name":"Alpha"}')
	fs.writeStringToFile(path.join(folder, "notes.txt"), "not a theme")

	local files = readThemeFiles(root)
	assert.eq(#files, 2)
	assert.eq(files[1].file, "alpha.json")
	assert.eq(files[1].text, '{"name":"Alpha"}')
	assert.eq(files[1].error, nil)
	assert.eq(files[2].file, "zebra.json")
	assert.eq(files[2].text, '{"name":"Zebra"}')
end)

test.case("reports a file too large to read instead of reading it", function(assert)
	local root = testing.directory("theme-files-large")
	local folder = path.join(root, "themes")
	fs.createDirectory(folder, { makeParents = true })
	fs.writeStringToFile(path.join(folder, "huge.json"), string.rep("x", 256 * 1024 + 1))

	local files = readThemeFiles(root)
	assert.eq(#files, 1)
	assert.eq(files[1].file, "huge.json")
	assert.eq(files[1].text, nil)
	assert.eq(files[1].error ~= nil, true)
end)
