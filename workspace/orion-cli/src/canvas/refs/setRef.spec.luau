local test = require("@std/test")

local getRefs = require("@root/canvas/refs/getRefs")
local setRef = require("@root/canvas/refs/setRef")
local testing = require("@root/testing")

test.case("setRef puts new pulls first and merges an existing identity in place", function(assert)
	local item = testing.task("a", "A", "todo")
	setRef(item, { source = "jira", kind = "issue", key = "ORN-1", url = "first" })
	setRef(item, { source = "hop", kind = "branch", key = "vocksel/orion@main" })
	setRef(item, { source = "github", kind = "pull", key = "vocksel/orion#2" })
	setRef(item, { source = "jira-two", kind = "issue", key = "orn-1", status = "Done" })
	local refs = getRefs(item)
	assert.eq(#refs, 3)
	assert.eq(refs[1].kind, "pull")
	assert.eq(refs[2].source, "jira-two")
	assert.eq(refs[2].url, "first")
	assert.eq(refs[2].status, "Done")
end)

test.case("setRef merges a ref with the same id and takes its new key", function(assert)
	local item = testing.task("a", "A", "todo")
	setRef(item, { source = "github", kind = "pull", key = "vocksel/orion#2", id = "R_1#2", status = "open" })
	setRef(item, { source = "github", kind = "pull", key = "gummy-galaxy/orion#2", id = "R_1#2" })
	local refs = getRefs(item)
	assert.eq(#refs, 1)
	assert.eq(refs[1].key, "gummy-galaxy/orion#2")
	assert.eq(refs[1].status, "open")
end)

test.case("setRef keeps a ref with a different id apart, even under the same key", function(assert)
	local item = testing.task("a", "A", "todo")
	setRef(item, { source = "github", kind = "pull", key = "vocksel/orion#2", id = "R_1#2" })
	setRef(item, { source = "github", kind = "pull", key = "vocksel/orion#2", id = "R_2#2" })
	assert.eq(#getRefs(item), 2)
end)
