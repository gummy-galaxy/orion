local test = require("@std/test")

local createSource = require("@root/adapters/hop/createSource")

test.case("hop adapter defaults to hop and validates executable", function(assert)
	local source, command = createSource({})
	assert.eq(source, { id = "hop", kind = "hop" })
	assert.eq(command, nil)
	assert.eq(select(2, createSource({ command = { '["/usr/local/bin/hop"]' } })), { "/usr/local/bin/hop" })
	assert.throws(function()
		createSource({ command = { '["/usr/local/bin/python"]' } })
	end)
	assert.throws(function()
		createSource({ command = { '["hop","--token"]' } })
	end)
	assert.throws(function()
		createSource({ browse = { "https://example.com" } })
	end)
end)
