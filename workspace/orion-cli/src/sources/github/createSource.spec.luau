local test = require("@std/test")

local createSource = require("@root/sources/github/createSource")

test.case("GitHub adapter validates host, owners, and filters", function(assert)
	local source = createSource({ host = { "github.com" }, owners = { "Roblox" }, include = { "avatar" } })
	assert.eq(source.id, "gh-roblox")
	assert.eq(source.include, { "avatar" })
	assert.throws(function()
		createSource({ host = { "bad/@host" }, owners = { "Roblox" } })
	end)
	assert.throws(function()
		createSource({ host = { "github.com" }, owners = { "bad/owner" } })
	end)
	assert.throws(function()
		createSource({ host = { "github.com" }, owners = { "Roblox" }, command = { "[]" } })
	end)
end)
