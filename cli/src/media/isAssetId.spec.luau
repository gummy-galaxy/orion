local test = require("@std/test")

local isAssetId = require("@root/media/isAssetId")

test.case("asset ids are lowercase names with an image extension", function(assert)
	assert.eq(isAssetId("image-logo.png"), true)
	assert.eq(isAssetId("image-1760-42-3.webp"), true)
	assert.eq(isAssetId("image-photo.jpg"), true)
	assert.eq(isAssetId("image-photo.gif"), true)
end)

test.case("paths, other extensions, and colors are not asset ids", function(assert)
	assert.eq(isAssetId("../orion.json"), false)
	assert.eq(isAssetId("assets/image-logo.png"), false)
	assert.eq(isAssetId("image-logo.svg"), false)
	assert.eq(isAssetId("Image-Logo.png"), false)
	assert.eq(isAssetId("image-logo"), false)
	assert.eq(isAssetId("#1d1b2e"), false)
	assert.eq(isAssetId("card.background"), false)
end)
