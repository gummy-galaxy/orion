local test = require("@std/test")

local checkBackground = require("@root/style/checkBackground")

test.case("a background accepts hex colors, color tokens, and image asset ids", function(assert)
	assert.eq(checkBackground("#abc"), nil)
	assert.eq(checkBackground("#1d1b2e"), nil)
	assert.eq(checkBackground("#1d1b2e80"), nil)
	assert.eq(checkBackground("card.background"), nil)
	assert.eq(checkBackground("canvas.background"), nil)
	assert.eq(checkBackground("image-logo.png"), nil)
end)

test.case("a background refuses anything else, and names what it takes", function(assert)
	assert.throws(function()
		checkBackground("#12")
	end)
	assert.throws(function()
		checkBackground("#12345")
	end)
	assert.throws(function()
		checkBackground("#xyz")
	end)
	assert.throws(function()
		checkBackground("red")
	end)
	assert.throws(function()
		checkBackground("url(https://example.com/a.png)")
	end)
	assert.throws(function()
		checkBackground("../secret.png")
	end)
end)
