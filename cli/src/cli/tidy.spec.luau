local json = require("@std/json")
local test = require("@std/test")

local graph = require("@root/graph")
local store = require("@root/store")
local testing = require("@root/testing")

local function report(text: string): json.Object
	return json.asObject(json.deserialize(text) :: json.Value) :: json.Object
end

test.case("tidy marks groups for the app and says the layout runs when it opens", function(assert)
	local dir, run = testing.createHarness("tidy-mark")
	assert.strContains(run({ "tidy", "ws" }), "Marked 1 group to tidy at revision 0 → 1")
	local text = run({ "tidy", "ws", "--dry-run" })
	assert.strContains(text, "Would tidy 1 group at revision 1")
	assert.eq(store.load(dir).revision, 1)
	local doc = store.load(dir)
	assert.eq(graph.get(doc, "ws").data.layout, "refit")
	local tidied = report(testing.run(dir, { "tidy", "ws", "--json" }))
	assert.eq(tidied.appConnected, false)
	assert.eq(tidied.revision, 2)
	assert.eq(graph.get(store.load(dir), "ws").data.layout, "refit")
end)

test.case("tidy previews without marking, and text output names the app's next step", function(assert)
	local dir, run = testing.createHarness("tidy-preview")
	local preview = run({ "tidy", "ws", "--dry-run" })
	assert.strContains(preview, "Would tidy 1 group at revision 0")
	assert.strNotContains(preview, "No app is connected")
	assert.eq(graph.get(store.load(dir), "ws").data.layout, nil)
	assert.strContains(run({ "tidy", "ws" }), "No app is connected, so the layout runs when the app opens.")
end)

test.case("tidy keeps a pending marker and accepts a where expression", function(assert)
	local dir = testing.directory("tidy-pending")
	local pending = testing.group("pending", "Pending")
	pending.data.layout = "pending"
	store.write(dir, testing.createDoc({ pending, testing.group("other", "Other") }))
	assert.strContains(testing.run(dir, { "tidy", "--where", [[label = "Other"]] }), "Marked 1 group")
	assert.eq(graph.get(store.load(dir), "other").data.layout, "refit")
	testing.run(dir, { "tidy", "pending" })
	assert.eq(graph.get(store.load(dir), "pending").data.layout, "pending")
end)

test.case("tidy rejects cards, unknown ids, and stale revisions without writing", function(assert)
	local dir, run = testing.createHarness("tidy-reject")
	assert.throwsWith('"ci" is an item, not a group', function()
		run({ "tidy", "ci" })
	end)
	assert.throwsWith('no item or group with id "missing"', function()
		run({ "tidy", "ws", "missing" })
	end)
	assert.throwsWith("revision changed: expected 4, current 0", function()
		run({ "tidy", "ws", "--if-revision", "4" })
	end)
	assert.throwsWith("--if-revision must be a nonnegative integer", function()
		run({ "tidy", "ws", "--if-revision", "x" })
	end)
	assert.eq(store.load(dir).revision, 0)
	assert.eq(graph.get(store.load(dir), "ws").data.layout, nil)
end)
