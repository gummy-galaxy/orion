local fs = require("@std/fs")
local json = require("@std/json")
local path = require("@std/path")
local test = require("@std/test")

local store = require("@root/store")
local testing = require("@root/testing")

test.case("backups lists newest first with revision, time, and size", function(assert)
	local dir, run = testing.createHarness("backups")
	local folder = path.join(dir, "backups")
	fs.createDirectory(folder)
	fs.writeStringToFile(path.join(folder, "orion-r2-20261002T010000Z.json"), "old")
	fs.writeStringToFile(path.join(folder, "orion-r1-20261003T010000Z.json"), "newer")
	local values = json.asArray(json.deserialize(run({ "backups", "--json" })) :: json.Value)
	local first = if values then json.asObject(values[1]) else nil
	assert.eq(values and #values, 2)
	assert.eq(first and first.revision, 1)
	assert.eq(first and first.time, "20261003T010000Z")
	assert.eq(first and first.size, 5)
	assert.strContains(run({ "backups" }), "r1  20261003T010000Z  5 bytes")
end)

test.case("--workspace lists backups from the selected workspace", function(assert)
	local root, run, setWorkspace = testing.createHarness("workspace-backups")
	run({ "workspace", "create", "roblox" })
	local roblox = store.getWorkspaceDir(root, "roblox")
	store.transaction(root, function() end)
	store.transaction(roblox, function() end)
	store.transaction(roblox, function() end)
	assert.eq(#store.getBackups(root), 1)
	assert.eq(#store.getBackups(roblox), 2)
	local defaultBackups = json.asArray(json.deserialize(run({ "backups", "--json" })) :: json.Value)
	local selectedBackups =
		json.asArray(json.deserialize(run({ "backups", "--json", "--workspace", "roblox" })) :: json.Value)
	assert.eq(defaultBackups and #defaultBackups, 1)
	assert.eq(selectedBackups and #selectedBackups, 2)
	setWorkspace("roblox")
	local configuredBackups = json.asArray(json.deserialize(run({ "backups", "--json" })) :: json.Value)
	assert.eq(configuredBackups and #configuredBackups, 2)
	local overriddenBackups =
		json.asArray(json.deserialize(run({ "--workspace", "default", "backups", "--json" })) :: json.Value)
	assert.eq(overriddenBackups and #overriddenBackups, 1)
end)
