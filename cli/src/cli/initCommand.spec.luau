local fs = require("@std/fs")
local json = require("@std/json")
local path = require("@std/path")
local test = require("@std/test")

local store = require("@root/store")
local testing = require("@root/testing")

test.case("init creates the default workspace with store defaults and JSON output", function(assert)
	local root = testing.directory("init-default")
	local output =
		json.asObject(json.deserialize(testing.run(root, { "init", "--owner", "Roblox", "--json" })) :: json.Value)
	local file = store.filePath(root)
	assert.eq(output and output.path, file)
	assert.eq(output and output.workspace, "default")
	assert.eq(fs.exists(file), true)
	local doc = store.load(root)
	assert.eq(doc.version, 1)
	assert.eq(doc.revision, 0)
	assert.eq(doc.settings.githubOwner, "Roblox")
	assert.eq(#doc.settings.sources, 0)
	assert.eq(#doc.nodes, 0)
	assert.eq(#doc.links, 0)
	assert.eq(fs.exists(path.join(root, "orion.lock")), false)
	assert.eq(#store.getBackups(root), 0)
end)

test.case("init uses the selected workspace and default GitHub owner", function(assert)
	local root = testing.directory("init-selected")
	store.createWorkspace(root, "ideas")
	local dir = store.getWorkspaceDir(root, "ideas")
	fs.remove(store.filePath(dir))
	local output = testing.run(root, { "init", "--workspace", "ideas" })
	assert.strContains(output, store.filePath(dir))
	assert.eq(store.load(dir).settings.githubOwner, "flipbook-labs")
	assert.eq(fs.exists(store.filePath(root)), false)
end)

test.case("init refuses to replace existing data", function(assert)
	local root = testing.directory("init-existing")
	store.initialize(root)
	local file = store.filePath(root)
	local before = fs.readFileToString(file)
	assert.throwsWith(`Orion data already exists at {file}`, function()
		testing.run(root, { "init" })
	end)
	assert.eq(fs.readFileToString(file), before)
	assert.eq(#store.getBackups(root), 0)
	assert.eq(fs.exists(path.join(root, "orion.lock")), false)
end)

test.case("init help shows owner and JSON options", function(assert)
	local root = testing.directory("init-help")
	local output = testing.run(root, { "init", "--help" })
	assert.strContains(output, "--owner")
	assert.strContains(output, "--json")
	assert.eq(fs.exists(root), false)
end)
