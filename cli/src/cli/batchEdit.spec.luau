local json = require("@std/json")
local test = require("@std/test")

local graph = require("@root/graph")
local render = require("@root/render")
local store = require("@root/store")
local testing = require("@root/testing")

local function report(text: string): json.Object
	return json.asObject(json.deserialize(text) :: json.Value) :: json.Object
end

test.case("query finds cards and groups using one derived snapshot", function(assert)
	local dir, run = testing.createHarness("query")
	local cards = json.asArray(
		json.deserialize(run({ "node", "query", "--where", [[repo = "flipbook-labs/flipbook"]], "--json" })) :: json.Value
	)
	assert.eq(cards and #cards, 1)
	local card = if cards then json.asObject(cards[1]) else nil
	assert.eq(card and card.id, "ci")
	local doc = store.load(dir)
	local text = run({ "node", "query", "--where", [[repo = "flipbook-labs/flipbook"]] })
	local item = graph.get(doc, "ci")
	assert.eq(text, render.table(doc, graph.derive(doc), { item }))
	local groups =
		json.asArray(json.deserialize(run({ "node", "query", "--where", [[kind = "group"]], "--json" })) :: json.Value)
	assert.eq(groups and #groups, 1)
	local group = if groups then json.asObject(groups[1]) else nil
	assert.eq(group and group.kind, "group")
	local groupText = run({ "node", "query", "--where", [[kind = "group"]] })
	assert.strContains(groupText, "group    ws")
	assert.strNotContains(groupText, "ready")
	run({ "card", "done", "ci" })
	assert.eq(run({ "node", "query", "--where", [[status = "done"]] }), "Nothing matches.")
	assert.strContains(run({ "node", "query", "--where", [[status = "done"]], "--all" }), "ci")
end)

test.case("batch done previews revision and applies all targets once", function(assert)
	local dir, run = testing.createHarness("batch-done")
	local before = store.load(dir).revision
	assert.strContains(run({ "card", "done", "ci", "pub", "--dry-run" }), "Would mark 2 items done at revision 0")
	local preview = report(run({ "card", "done", "ci", "pub", "--dry-run", "--json" }))
	assert.eq(preview.dryRun, true)
	assert.eq(preview.revision, before)
	local entries = json.asArray(preview.items)
	assert.eq(entries and #entries, 2)
	assert.eq(store.load(dir).revision, before)
	local applied = report(run({ "card", "done", "ci", "pub", "--if-revision", tostring(before), "--json" }))
	assert.eq(applied.baseRevision, before)
	assert.eq(applied.revision, before + 1)
	assert.eq(store.load(dir).revision, before + 1)
	assert.eq(store.load(dir).nodes[2].data.status, "done")
	assert.eq(store.load(dir).nodes[3].data.status, "done")
end)

test.case("batch text summaries use readable action verbs", function(assert)
	local _, run = testing.createHarness("batch-verbs")
	assert.strContains(run({ "card", "done", "ci", "pub" }), "Marked 2 items done at revision 0 → 1")
	local _, removeRun = testing.createHarness("batch-remove-verb")
	assert.strContains(removeRun({ "node", "remove", "ci", "--dry-run" }), "Would remove 1 item at revision 0")
end)

test.case("stale revision and invalid target abort the whole batch", function(assert)
	local dir, run = testing.createHarness("batch-atomic")
	assert.throwsWith("revision changed: expected 4, current 0", function()
		run({ "card", "done", "ci", "pub", "--if-revision", "4" })
	end)
	assert.throwsWith('no item or group with id "missing"', function()
		run({ "card", "done", "ci", "missing" })
	end)
	assert.eq(store.load(dir).revision, 0)
	assert.eq(store.load(dir).nodes[2].data.status, "active")
end)

test.case("where selects edits under the lock and respects id exclusivity", function(assert)
	local dir, run = testing.createHarness("batch-where")
	local preview =
		report(run({ "node", "remove", "--where", [[repo = "flipbook-labs/flipbook"]], "--dry-run", "--json" }))
	assert.eq(preview.revision, 0)
	assert.eq(#store.load(dir).nodes, 3)
	assert.throwsWith("use ids or --where, not both", function()
		run({ "node", "remove", "ci", "--where", [[repo = "flipbook-labs/flipbook"]] })
	end)
	local removed = run({ "node", "remove", "--where", [[repo = "flipbook-labs/flipbook"]], "--if-revision", "0" })
	assert.strContains(removed, "Removed 1 item at revision 0 → 1")
	assert.eq(store.load(dir).revision, 1)
	assert.eq(#store.load(dir).nodes, 2)
end)

test.case("invalid or empty selection leaves the document untouched", function(assert)
	local dir, run = testing.createHarness("batch-empty")
	assert.throwsWith("no items match", function()
		run({ "node", "remove", "--where", [[repo = "elsewhere"]] })
	end)
	assert.throwsWith("query at column 6: unknown field 'owner'", function()
		run({ "node", "remove", "--where", [[owner = "orion"]] })
	end)
	assert.eq(store.load(dir).revision, 0)
	assert.eq(#store.load(dir).nodes, 3)
end)

test.case("move and ungroup batches write one revision each", function(assert)
	local dir = testing.directory("batch-groups")
	store.write(
		dir,
		testing.createDoc({
			testing.group("first", "First"),
			testing.group("second", "Second"),
			testing.task("a", "A", "todo", "first"),
			testing.task("b", "B", "todo", "first"),
		})
	)
	local movedText = testing.run(dir, { "node", "move", "a", "b", "--to", "second" })
	assert.strContains(movedText, "Moved 2 items to second at revision 0 → 1")
	local moved = store.load(dir)
	assert.eq(moved.revision, 1)
	assert.eq(graph.get(moved, "a").parentId, "second")
	assert.eq(graph.get(moved, "b").parentId, "second")
	local preview = testing.run(dir, { "group", "ungroup", "--where", [[kind = "group"]], "--dry-run" })
	assert.strContains(preview, "Would ungroup 1 group at revision 1")
	local ungroupedText = testing.run(dir, { "group", "ungroup", "--where", [[kind = "group"]] })
	assert.strContains(ungroupedText, "Ungrouped 1 group at revision 1 → 2")
	local ungrouped = store.load(dir)
	assert.eq(ungrouped.revision, 2)
	assert.eq(#ungrouped.nodes, 2)
	assert.eq(ungrouped.nodes[1].parentId, nil)
end)

test.case("single id output remains unchanged, and done supports JSON", function(assert)
	local dir, run = testing.createHarness("batch-single")
	local preview = run({ "node", "move", "pub", "--top", "--dry-run" })
	assert.strContains(preview, "Would move 1 item to the top level at revision 0")
	assert.eq(store.load(dir).revision, 0)
	assert.eq(run({ "card", "done", "ci" }), "Done: ci · Report release health")
	assert.throwsWith("revision changed: expected 0, current 1", function()
		run({ "card", "done", "pub", "--if-revision", "0" })
	end)
	local value = report(run({ "card", "done", "pub", "--json" }))
	assert.eq(value.action, "done")
	assert.eq(value.revision, 2)
end)
