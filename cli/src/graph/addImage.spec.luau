local test = require("@std/test")

local addImage = require("@root/graph/addImage")
local testing = require("@root/testing")

test.case("addImage adds an image node named after its label", function(assert)
	local doc = testing.createDoc({ testing.group("g", "Group") })
	local image = addImage(doc, "Logo", "png", "default", "g")
	assert.eq(image.id, "image-logo")
	assert.eq(image.type, "image")
	assert.eq(image.parentId, "g")
	assert.eq(image.data.asset, "image-logo.png")
	assert.eq(image.data.workspace, "default")
	assert.eq(addImage(doc, "Logo", "png", "default").id, "image-logo-2")
end)

test.case("addImage refuses an empty label and a missing group", function(assert)
	local doc = testing.createDoc({})
	assert.throwsWith("an image needs a label", function()
		addImage(doc, "", "png", "default")
	end)
	assert.throwsWith('no item or group with id "missing"', function()
		addImage(doc, "Logo", "png", "default", "missing")
	end)
end)
