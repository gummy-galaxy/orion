local test = require("@std/test")

local getRefs = require("@root/refs/getRefs")
local setRef = require("@root/refs/setRef")
local testing = require("@root/testing")

test.case("setRef puts new pulls first and merges an existing identity in place", function(assert)
	local item = testing.task("a", "A", "todo")
	setRef(item, { source = "jira", kind = "issue", key = "ORN-1", url = "first" })
	setRef(item, { source = "hop", kind = "branch", key = "vocksel/orion@main" })
	setRef(item, { source = "github", kind = "pull", key = "vocksel/orion#2" })
	setRef(item, { source = "jira-two", kind = "issue", key = "orn-1", status = "Done" })
	local refs = getRefs(item)
	assert.eq(#refs, 3)
	assert.eq(refs[1].kind, "pull")
	assert.eq(refs[2].source, "jira-two")
	assert.eq(refs[2].url, "first")
	assert.eq(refs[2].status, "Done")
end)
