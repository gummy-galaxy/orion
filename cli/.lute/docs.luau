--[[
	Writes the generated reference pages in `docs/reference/` from the CLI's command table and the MCP tool catalog,
	so the docs site always shows the surface the code defines. Run it after changing a command, an option, or an MCP
	tool, and commit what it writes. With `--check`, it writes nothing and exits nonzero when a page is out of date.
]]
local fs = require("@std/fs")
local json = require("@std/json")
local path = require("@std/path")
local process = require("@std/process")

local cliModule = require("@root/cli")
local describeCommands = require("@root/cli/describeCommands")
local mcpTypes = require("@root/cli/mcp/types")
local tools = require("@root/cli/mcp/tools")

type CommandDescription = describeCommands.CommandDescription
type Argument = describeCommands.Argument
type Tool = mcpTypes.Tool

type Page = {
	file: path.Path,
	contents: string,
}

local HEADER =
	"<!-- Generated by cli/.lute/docs.luau from the command table. Run `lute run docs` in cli/ to update. -->"

local referenceDir = path.resolve("../docs/reference")
local checkOnly = table.find(process.args, "--check") ~= nil

-- Help text is plain prose, but VitePress compiles Markdown as Vue templates, so angle brackets and table pipes
-- must be escaped outside code.
local function escape(text: string?): string
	local escaped = (text or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub("|", "\\|")
	return escaped
end

local function argumentLabel(argument: Argument): string
	if argument.kind == "positional" then
		return if argument.required then `<{argument.name}>` else `[{argument.name}]`
	elseif argument.kind == "variadic" then
		return if argument.required then `<{argument.name}...>` else `[{argument.name}...]`
	elseif argument.kind == "option" then
		return `--{argument.name} <value>`
	end

	return `--{argument.name}`
end

local function renderArguments(arguments: { Argument }): string
	if #arguments == 0 then
		return ""
	end

	local lines = { "| Argument | Description |", "| --- | --- |" }

	for _, argument in arguments do
		local required = if argument.required then "**Required.** " else ""
		table.insert(lines, `| \`{argumentLabel(argument)}\` | {required}{escape(argument.help)} |`)
	end

	return table.concat(lines, "\n") .. "\n"
end

local function renderCommand(command: CommandDescription, depth: number): string
	local heading = string.rep("#", depth)
	local parts = {
		`{heading} {command.name}`,
		"",
		escape(command.help),
		"",
		"```sh",
		command.usage,
		"```",
		"",
		renderArguments(command.arguments),
	}

	for _, child in command.commands do
		table.insert(parts, renderCommand(child, math.min(depth + 1, 4)))
	end

	return table.concat(parts, "\n")
end

local function slug(command: CommandDescription): string
	local name = command.name:gsub("^orion ", "")
	return name
end

local function renderIndex(root: CommandDescription): string
	local lines = {
		HEADER,
		"",
		"# CLI reference",
		"",
		escape(root.help) .. ".",
		"",
		"```sh",
		root.usage,
		"```",
		"",
		"Every command also takes `--workspace <name>` to work in a specific workspace, and `--help` (`-h`) to print its help.",
		"",
		"| Command | What it does |",
		"| --- | --- |",
	}

	for _, command in root.commands do
		table.insert(lines, `| [\`{command.name}\`](./{slug(command)}) | {escape(command.help)} |`)
	end

	return table.concat(lines, "\n") .. "\n"
end

local function renderTool(tool: Tool): string
	local parts = {
		`## {tool.name}`,
		"",
		escape(tool.description),
		"",
	}

	-- A tool with its own build picks the command from its arguments.
	if #tool.command > 0 then
		table.insert(parts, `Runs \`orion {table.concat(tool.command, " ")}\`.\n`)
	end

	if #tool.fields == 0 then
		table.insert(parts, "Takes no arguments.\n")
	else
		table.insert(parts, "| Argument | Type | Description |")
		table.insert(parts, "| --- | --- | --- |")

		for _, field in tool.fields do
			local kind = if field.values then table.concat(field.values, " \\| ") else field.kind
			local required = if field.required then "**Required.** " else ""
			table.insert(parts, `| \`{field.name}\` | {kind} | {required}{escape(field.description)} |`)
		end

		table.insert(parts, "")
	end

	return table.concat(parts, "\n")
end

local function renderMcp(): string
	local parts = {
		HEADER,
		"",
		"# MCP reference",
		"",
		"`orion mcp` serves these tools over stdio. Each one runs a CLI command, so it reads and writes the same data.",
		"",
	}

	for _, tool in tools do
		table.insert(parts, renderTool(tool))
	end

	return table.concat(parts, "\n")
end

-- The site's config reads this to build the reference sidebar, so a new command shows up without editing it.
local function renderSidebar(root: CommandDescription): string
	local items: json.Array = {}

	for _, command in root.commands do
		table.insert(items, json.object({ text = slug(command), link = `/reference/cli/{slug(command)}` }))
	end

	return json.serialize(items, true) .. "\n"
end

local function collectPages(): { Page }
	local root = cliModule.describe()
	local pages: { Page } = {
		{ file = path.join(referenceDir, "cli", "index.md"), contents = renderIndex(root) },
		{ file = path.join(referenceDir, "cli", "sidebar.json"), contents = renderSidebar(root) },
		{ file = path.join(referenceDir, "mcp.md"), contents = renderMcp() },
	}

	for _, command in root.commands do
		local contents = `{HEADER}\n\n{renderCommand(command, 1)}`
		table.insert(pages, { file = path.join(referenceDir, "cli", `{slug(command)}.md`), contents = contents })
	end

	return pages
end

local pages = collectPages()
local stale: { path.Path } = {}

for _, page in pages do
	local current = if fs.exists(page.file) then fs.readFileToString(page.file) else nil

	if current ~= page.contents then
		table.insert(stale, page.file)

		if not checkOnly then
			fs.writeStringToFile(page.file, page.contents)
		end
	end
end

if checkOnly and #stale > 0 then
	print("These reference pages are out of date. Run `lute run docs` in cli/ and commit the result:")

	for _, file in stale do
		print(`  {path.format(file)}`)
	end

	process.exit(1)
end

print(if #stale == 0 then "Reference pages are up to date" else `Wrote {#stale} reference pages`)
